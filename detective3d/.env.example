# Bu dosyayı ".env" adıyla kopyala ve doldur.
# .env repo dışında durur; asla commit etme, kimseyle paylaşma, sohbete yapıştırma.

# --- Ücretsiz seçenek (önerilen: groq) ------------------------------------
#   groq       https://console.groq.com/keys            (kredi kartı istemiyor)
#   gemini     https://aistudio.google.com/apikey       (Google hesabı yeterli)
#   openrouter https://openrouter.ai/keys               (":free" modeller)
#   ollama     yerel, anahtar gerekmez (önce: ollama pull qwen2.5:7b)
LLM_PROVIDER=groq
LLM_API_KEY=

# İsteğe bağlı: modeli değiştir (boşsa sağlayıcının varsayılanı kullanılır)
#   groq: openai/gpt-oss-120b | gemini: gemini-flash-latest | ollama: qwen2.5:7b
LLM_MODEL=

# --- Ücretli seçenek: Claude ------------------------------------------------
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
# AGENT_MODEL=claude-opus-5-5
